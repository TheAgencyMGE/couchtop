<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Couchtop.Setup</AssemblyName>
    <RootNamespace>Couchtop.Setup</RootNamespace>
    <ApplicationManifest>..\..\build\common.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('..\..\assets\Couchtop.ico')">..\..\assets\Couchtop.ico</ApplicationIcon>
    <StartupObject>Couchtop.Setup.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Couchtop.Core\Couchtop.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Couchtop.Tests" />
  </ItemGroup>
</Project>
