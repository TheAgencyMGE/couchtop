<Window x:Class="Couchtop.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Couchtop.App.Controls"
        Title="Couchtop"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Ideal"
        Width="1280" Height="720">
    <Grid x:Name="RootGrid" ClipToBounds="True">
        <Rectangle Fill="{DynamicResource BackgroundBrush}" />
        <Rectangle Fill="{DynamicResource StripeBrush}" />

        <Grid x:Name="ViewLayer" />

        <Grid x:Name="ToastLayer" IsHitTestVisible="False" VerticalAlignment="Top" HorizontalAlignment="Center">
            <Border x:Name="Toast" Style="{StaticResource AppPanel}" Padding="40,14" Margin="0,26,0,0" Opacity="0" CornerRadius="34">
                <TextBlock x:Name="ToastText" Style="{StaticResource AppText}" FontSize="28" FontWeight="Bold" TextWrapping="NoWrap" />
            </Border>
        </Grid>

        <Grid x:Name="DialogLayer" Visibility="Collapsed">
            <Rectangle x:Name="DialogScrim" Fill="{DynamicResource ScrimBrush}" />
            <Viewbox Stretch="Uniform">
                <Grid Width="1920" Height="1080">
                    <ContentControl x:Name="DialogHost" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" RenderTransformOrigin="0.5,0.5">
                        <ContentControl.RenderTransform>
                            <ScaleTransform x:Name="DialogScale" />
                        </ContentControl.RenderTransform>
                    </ContentControl>
                </Grid>
            </Viewbox>
        </Grid>

        <Grid x:Name="SplashLayer" Visibility="Collapsed">
            <Rectangle Fill="{DynamicResource BackgroundBrush}" />
            <Viewbox Stretch="Uniform">
                <Grid Width="1920" Height="1080">
                    <Ellipse x:Name="SplashGlow" Width="1300" Height="700" Opacity="0">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#664FD0FF" Offset="0" />
                                <GradientStop Color="#004FD0FF" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="SplashTitle" Text="Couchtop" FontSize="170" FontWeight="ExtraBold" Foreground="{DynamicResource ClockBrush}" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <ScaleTransform x:Name="SplashScale" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="SplashHint" Text="Click or press any key to continue" FontSize="40" Foreground="{DynamicResource SubtleTextBrush}" HorizontalAlignment="Center" Margin="0,40,0,0" Opacity="0" />
                    </StackPanel>
                </Grid>
            </Viewbox>
        </Grid>

        <Border x:Name="FlashLayer" Background="White" Opacity="0" IsHitTestVisible="False" />

        <Canvas x:Name="PointerLayer" IsHitTestVisible="False">
            <Border x:Name="Bubble" Visibility="Collapsed" CornerRadius="30" BorderThickness="4" Padding="28,10,28,12"
                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource TileBorderBrush}">
                <Border.LayoutTransform>
                    <ScaleTransform x:Name="BubbleScale" />
                </Border.LayoutTransform>
                <TextBlock x:Name="BubbleText" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" TextWrapping="NoWrap" />
            </Border>
            <c:HandPointer x:Name="Pointer" Visibility="Collapsed" RenderTransformOrigin="0.4,0.0725" />
        </Canvas>
    </Grid>
</Window>
