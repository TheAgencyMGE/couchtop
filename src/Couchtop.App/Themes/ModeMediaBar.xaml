<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        Media Bar shell. Not a Couchtop theme: this is the whole look of the Media Bar menu style, applied to
        every screen so Settings, Files, Power and the dialogs match the home screen. Deep blue-black, thin
        hairlines, silver text, restrained highlights and no gloss. Deliberately has no Art.* templates: the
        shell draws apps with their own icons instead of illustrated channel art.
    -->

    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <CornerRadius x:Key="PillCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="PillGlowCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="PillGlossCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="RoundCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="TileCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="TileGlowCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="TileGlossCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="PanelCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="ItemCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="InputCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="TrackCornerRadius">2</CornerRadius>
    <Thickness x:Key="PillBorderThickness">1</Thickness>
    <Thickness x:Key="RoundBorderThickness">1</Thickness>
    <Thickness x:Key="TileBorderThickness">1</Thickness>
    <Thickness x:Key="PanelBorderThickness">1</Thickness>
    <sys:Double x:Key="TileClipRadius">2</sys:Double>
    <sys:Double x:Key="TileChamfer">0</sys:Double>
    <sys:Double x:Key="TileGlossOpacity">0</sys:Double>
    <Color x:Key="CardMixColor">#0B1424</Color>
    <sys:Double x:Key="CardMixTop">0.8</sys:Double>
    <sys:Double x:Key="CardMixBottom">0.8</sys:Double>
    <Color x:Key="BarShadowColor">#000000</Color>
    <sys:Double x:Key="BarShadowOpacity">0.55</sys:Double>

    <Color x:Key="AccentColor">#CFE3FF</Color>
    <Color x:Key="AccentDeepColor">#FFFFFF</Color>
    <Color x:Key="TileBorderColor">#24304A</Color>
    <Color x:Key="ButtonBorderColor">#31405F</Color>
    <Color x:Key="ButtonTextColor">#E9EFF8</Color>

    <LinearGradientBrush x:Key="BackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#141C36" Offset="0" />
        <GradientStop Color="#05070E" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="StripeBrush" Color="#00000000" />

    <SolidColorBrush x:Key="AccentBrush" Color="#CFE3FF" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#4DCFE3FF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#16203A" />
    <SolidColorBrush x:Key="TileGlowBrush" Color="#40CFE3FF" />
    <SolidColorBrush x:Key="BadgeRimBrush" Color="#05070E" />

    <SolidColorBrush x:Key="TextBrush" Color="#F2F6FC" />
    <SolidColorBrush x:Key="TileTextBrush" Color="#F2F6FC" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#93A3BE" />
    <SolidColorBrush x:Key="ClockBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InverseTextBrush" Color="#05070E" />

    <SolidColorBrush x:Key="TileBorderBrush" Color="#24304A" />
    <SolidColorBrush x:Key="BubbleBorderBrush" Color="#31405F" />
    <SolidColorBrush x:Key="TileBackgroundBrush" Color="#111A2E" />
    <SolidColorBrush x:Key="EmptyTileBrush" Color="#800B1424" />
    <SolidColorBrush x:Key="EmptyTileBorderBrush" Color="#1C2740" />
    <SolidColorBrush x:Key="GlossBrush" Color="#00FFFFFF" />

    <SolidColorBrush x:Key="BarBrush" Color="#0A101E" />
    <SolidColorBrush x:Key="BarLineBrush" Color="#33507F" />

    <SolidColorBrush x:Key="PanelBrush" Color="#F20C1322" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#243049" />
    <SolidColorBrush x:Key="CardBrush" Color="#101A2C" />

    <SolidColorBrush x:Key="ButtonBrush" Color="#142038" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#31405F" />
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#E9EFF8" />
    <SolidColorBrush x:Key="TrackBrush" Color="#1D2A44" />
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#10FFFFFF" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#C0000308" />

    <SolidColorBrush x:Key="HeaderBrush" Color="#F20A101C" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#7FD6A6" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF8A93" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F2C572" />

    <!-- The shell uses the normal Windows pointer, so these only matter if the hand is ever forced on. -->
    <SolidColorBrush x:Key="PointerFillBrush" Color="#F2F6FC" />
    <SolidColorBrush x:Key="PointerOutlineBrush" Color="#05070E" />
    <SolidColorBrush x:Key="PointerShadowBrush" Color="#000000" />
    <SolidColorBrush x:Key="PointerCuffBrush" Color="#CFE3FF" />
    <RadialGradientBrush x:Key="SplashGlowBrush">
        <GradientStop Color="#33CFE3FF" Offset="0" />
        <GradientStop Color="#00CFE3FF" Offset="1" />
    </RadialGradientBrush>

    <SolidColorBrush x:Key="QuickScrimBrush" Color="#CC02040A" />
    <SolidColorBrush x:Key="QuickTopBrush" Color="#F50A101C" />
    <SolidColorBrush x:Key="QuickTopLineBrush" Color="#CFE3FF" />
    <SolidColorBrush x:Key="QuickBottomBrush" Color="#F5070B14" />
    <SolidColorBrush x:Key="QuickTextBrush" Color="#F2F6FC" />

    <!-- No drifting scenery: the home screen draws its own ribbons, every other screen stays flat. -->
    <DataTemplate x:Key="BackgroundDecorTemplate"><Grid /></DataTemplate>
    <DataTemplate x:Key="TileDecorTemplate"><Grid /></DataTemplate>
</ResourceDictionary>
