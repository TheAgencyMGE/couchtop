<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- High Contrast: black background, white text, yellow focus. Built for readability, not for looks. -->

    <FontFamily x:Key="AppFont">/Couchtop;component/Assets/Fonts/#Rounded Mplus 1c, Segoe UI</FontFamily>
    <CornerRadius x:Key="PillCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="PillGlowCornerRadius">20</CornerRadius>
    <CornerRadius x:Key="PillGlossCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="RoundCornerRadius">999</CornerRadius>
    <CornerRadius x:Key="TileCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="TileGlowCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="TileGlossCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="PanelCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ItemCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="InputCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="TrackCornerRadius">6</CornerRadius>
    <Thickness x:Key="PillBorderThickness">5</Thickness>
    <Thickness x:Key="RoundBorderThickness">5</Thickness>
    <Thickness x:Key="TileBorderThickness">5</Thickness>
    <Thickness x:Key="PanelBorderThickness">5</Thickness>
    <sys:Double x:Key="TileClipRadius">8</sys:Double>
    <sys:Double x:Key="TileChamfer">0</sys:Double>
    <sys:Double x:Key="TileGlossOpacity">0</sys:Double>
    <Color x:Key="CardMixColor">#000000</Color>
    <sys:Double x:Key="CardMixTop">1</sys:Double>
    <sys:Double x:Key="CardMixBottom">1</sys:Double>
    <Color x:Key="BarShadowColor">#000000</Color>
    <sys:Double x:Key="BarShadowOpacity">0</sys:Double>

    <Color x:Key="AccentColor">#FFE000</Color>
    <Color x:Key="AccentDeepColor">#FFF04A</Color>
    <Color x:Key="TileBorderColor">#FFFFFF</Color>
    <Color x:Key="ButtonBorderColor">#FFFFFF</Color>
    <Color x:Key="ButtonTextColor">#FFFFFF</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="StripeBrush" Color="#00000000" />

    <SolidColorBrush x:Key="AccentBrush" Color="#FFE000" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="#FFF04A" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#FFE000" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#33FFE000" />
    <SolidColorBrush x:Key="TileGlowBrush" Color="#FFE000" />
    <SolidColorBrush x:Key="BadgeRimBrush" Color="#000000" />

    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TileTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#D6D6D6" />
    <SolidColorBrush x:Key="ClockBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InverseTextBrush" Color="#000000" />

    <SolidColorBrush x:Key="TileBorderBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BubbleBorderBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TileBackgroundBrush" Color="#111111" />
    <SolidColorBrush x:Key="EmptyTileBrush" Color="#0A0A0A" />
    <SolidColorBrush x:Key="EmptyTileBorderBrush" Color="#8A8A8A" />
    <SolidColorBrush x:Key="GlossBrush" Color="#00000000" />

    <SolidColorBrush x:Key="BarBrush" Color="#000000" />
    <SolidColorBrush x:Key="BarLineBrush" Color="#FFE000" />

    <SolidColorBrush x:Key="PanelBrush" Color="#0B0B0B" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBrush" Color="#141414" />

    <SolidColorBrush x:Key="ButtonBrush" Color="#000000" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TrackBrush" Color="#4A4A4A" />
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#D2000000" />

    <SolidColorBrush x:Key="HeaderBrush" Color="#000000" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#4DFF4D" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF5C5C" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFB000" />

    <SolidColorBrush x:Key="PointerFillBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PointerOutlineBrush" Color="#000000" />
    <SolidColorBrush x:Key="PointerShadowBrush" Color="#000000" />
    <SolidColorBrush x:Key="PointerCuffBrush" Color="#FFE000" />
    <RadialGradientBrush x:Key="SplashGlowBrush">
        <GradientStop Color="#66FFE000" Offset="0" />
        <GradientStop Color="#00FFE000" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="QuickScrimBrush" Color="#E6000000" />
    <SolidColorBrush x:Key="QuickTopBrush" Color="#000000" />
    <SolidColorBrush x:Key="QuickTopLineBrush" Color="#FFE000" />
    <SolidColorBrush x:Key="QuickBottomBrush" Color="#000000" />
    <SolidColorBrush x:Key="QuickTextBrush" Color="#FFFFFF" />

    <DataTemplate x:Key="BackgroundDecorTemplate"><Grid /></DataTemplate>
    <DataTemplate x:Key="TileDecorTemplate"><Grid /></DataTemplate>
</ResourceDictionary>
