<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Classic: bright white console menu with light grey pinstripes and sky-blue accents. -->

    <!-- Type and shape -->
    <FontFamily x:Key="AppFont">/Couchtop;component/Assets/Fonts/#Rounded Mplus 1c, Segoe UI</FontFamily>
    <CornerRadius x:Key="PillCornerRadius">42</CornerRadius>
    <CornerRadius x:Key="PillGlowCornerRadius">48</CornerRadius>
    <CornerRadius x:Key="PillGlossCornerRadius">38,38,16,16</CornerRadius>
    <CornerRadius x:Key="RoundCornerRadius">999</CornerRadius>
    <CornerRadius x:Key="TileCornerRadius">26</CornerRadius>
    <CornerRadius x:Key="TileGlowCornerRadius">34</CornerRadius>
    <CornerRadius x:Key="TileGlossCornerRadius">20,20,90,90</CornerRadius>
    <CornerRadius x:Key="PanelCornerRadius">44</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">34</CornerRadius>
    <CornerRadius x:Key="ItemCornerRadius">26</CornerRadius>
    <CornerRadius x:Key="InputCornerRadius">36</CornerRadius>
    <CornerRadius x:Key="TrackCornerRadius">9</CornerRadius>
    <Thickness x:Key="PillBorderThickness">4</Thickness>
    <Thickness x:Key="RoundBorderThickness">5</Thickness>
    <Thickness x:Key="TileBorderThickness">4</Thickness>
    <Thickness x:Key="PanelBorderThickness">4</Thickness>
    <sys:Double x:Key="TileClipRadius">20</sys:Double>
    <sys:Double x:Key="TileChamfer">0</sys:Double>
    <sys:Double x:Key="TileGlossOpacity">0.5</sys:Double>
    <Color x:Key="CardMixColor">#FFFFFF</Color>
    <sys:Double x:Key="CardMixTop">0.86</sys:Double>
    <sys:Double x:Key="CardMixBottom">0.62</sys:Double>
    <Color x:Key="BarShadowColor">#3C6E86</Color>
    <sys:Double x:Key="BarShadowOpacity">0.18</sys:Double>

    <Color x:Key="AccentColor">#35B4E5</Color>
    <Color x:Key="AccentDeepColor">#1A9AD3</Color>
    <Color x:Key="TileBorderColor">#C4CCD1</Color>
    <Color x:Key="ButtonBorderColor">#BCC5CB</Color>
    <Color x:Key="ButtonTextColor">#5A6870</Color>

    <LinearGradientBrush x:Key="BackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F4F7F8" Offset="0.55" />
        <GradientStop Color="#E6ECEF" Offset="1" />
    </LinearGradientBrush>
    <DrawingBrush x:Key="StripeBrush" TileMode="Tile" Viewport="0,0,1,7" ViewportUnits="Absolute" Viewbox="0,0,1,7" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#0C5A6A73" Geometry="M0,0 H1 V1 H0 Z" />
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <SolidColorBrush x:Key="AccentBrush" Color="#35B4E5" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="#1A9AD3" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#8C4FD0FF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#DCF3FC" />
    <SolidColorBrush x:Key="TileGlowBrush" Color="#8C4FD0FF" />
    <SolidColorBrush x:Key="BadgeRimBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="TextBrush" Color="#55636B" />
    <SolidColorBrush x:Key="TileTextBrush" Color="#55636B" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#8A969C" />
    <SolidColorBrush x:Key="ClockBrush" Color="#9AA4AA" />
    <SolidColorBrush x:Key="InverseTextBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="TileBorderBrush" Color="#C4CCD1" />
    <SolidColorBrush x:Key="BubbleBorderBrush" Color="#C4CCD1" />
    <LinearGradientBrush x:Key="TileBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#EEF1F3" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmptyTileBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D9E0E4" Offset="0" />
        <GradientStop Color="#E7ECEF" Offset="0.25" />
        <GradientStop Color="#EDF1F3" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="EmptyTileBorderBrush" Color="#CCD4D9" />
    <LinearGradientBrush x:Key="GlossBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B3FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FCFDFE" Offset="0" />
        <GradientStop Color="#EDF2F5" Offset="0.5" />
        <GradientStop Color="#DCE4E9" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BarLineBrush" Color="#9ED4EA" />

    <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#EEF2F4" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#C4CCD1" />
    <SolidColorBrush x:Key="CardBrush" Color="#F7F9FA" />

    <LinearGradientBrush x:Key="ButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F1F4F6" Offset="0.5" />
        <GradientStop Color="#E2E8EC" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#BCC5CB" />
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#5A6870" />
    <SolidColorBrush x:Key="TrackBrush" Color="#D6DEE3" />
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#14000000" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#66303A40" />

    <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#E9EFF2" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SuccessBrush" Color="#5DBB3F" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E0556F" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E9A23B" />

    <!-- Pointer, splash and Quick Menu -->
    <LinearGradientBrush x:Key="PointerFillBrush" StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#FFFFFF" Offset="0.45" />
        <GradientStop Color="#C9E4F8" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PointerOutlineBrush" Color="#1B6FB8" />
    <SolidColorBrush x:Key="PointerShadowBrush" Color="#0B3A66" />
    <SolidColorBrush x:Key="PointerCuffBrush" Color="#E8F3FB" />
    <RadialGradientBrush x:Key="SplashGlowBrush">
        <GradientStop Color="#664FD0FF" Offset="0" />
        <GradientStop Color="#004FD0FF" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="QuickScrimBrush" Color="#A8081016" />
    <LinearGradientBrush x:Key="QuickTopBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F23BB4EA" Offset="0" />
        <GradientStop Color="#F21C7EBC" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="QuickTopLineBrush" Color="#E0FFFFFF" />
    <SolidColorBrush x:Key="QuickBottomBrush" Color="#EB1A2228" />
    <SolidColorBrush x:Key="QuickTextBrush" Color="#FFFFFF" />

    <DataTemplate x:Key="BackgroundDecorTemplate"><Grid /></DataTemplate>
    <DataTemplate x:Key="TileDecorTemplate"><Grid /></DataTemplate>
</ResourceDictionary>
