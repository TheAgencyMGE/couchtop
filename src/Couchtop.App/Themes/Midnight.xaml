<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:c="clr-namespace:Couchtop.App.Controls">
    <!--
        Midnight: sleek and flat. Near-black graphite, hairline borders, one periwinkle accent, soft ambient
        glows that slowly breathe, and quiet monochrome channel glyphs.
    -->

    <FontFamily x:Key="AppFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <CornerRadius x:Key="PillCornerRadius">18</CornerRadius>
    <CornerRadius x:Key="PillGlowCornerRadius">24</CornerRadius>
    <CornerRadius x:Key="PillGlossCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="RoundCornerRadius">999</CornerRadius>
    <CornerRadius x:Key="TileCornerRadius">20</CornerRadius>
    <CornerRadius x:Key="TileGlowCornerRadius">28</CornerRadius>
    <CornerRadius x:Key="TileGlossCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="PanelCornerRadius">26</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">20</CornerRadius>
    <CornerRadius x:Key="ItemCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="InputCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="TrackCornerRadius">9</CornerRadius>
    <Thickness x:Key="PillBorderThickness">2</Thickness>
    <Thickness x:Key="RoundBorderThickness">2</Thickness>
    <Thickness x:Key="TileBorderThickness">2</Thickness>
    <Thickness x:Key="PanelBorderThickness">2</Thickness>
    <sys:Double x:Key="TileClipRadius">16</sys:Double>
    <sys:Double x:Key="TileChamfer">0</sys:Double>
    <sys:Double x:Key="TileGlossOpacity">0</sys:Double>
    <Color x:Key="CardMixColor">#17191F</Color>
    <sys:Double x:Key="CardMixTop">0.86</sys:Double>
    <sys:Double x:Key="CardMixBottom">0.78</sys:Double>
    <Color x:Key="BarShadowColor">#000000</Color>
    <sys:Double x:Key="BarShadowOpacity">0.5</sys:Double>

    <Color x:Key="AccentColor">#8EA6FF</Color>
    <Color x:Key="AccentDeepColor">#B4C3FF</Color>
    <Color x:Key="TileBorderColor">#262A33</Color>
    <Color x:Key="ButtonBorderColor">#2E323C</Color>
    <Color x:Key="ButtonTextColor">#DADDE5</Color>

    <LinearGradientBrush x:Key="BackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0F1116" Offset="0" />
        <GradientStop Color="#0B0C10" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="StripeBrush" Color="#00000000" />

    <SolidColorBrush x:Key="AccentBrush" Color="#8EA6FF" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="#B4C3FF" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#4D8EA6FF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1D2338" />
    <SolidColorBrush x:Key="TileGlowBrush" Color="#408EA6FF" />
    <SolidColorBrush x:Key="BadgeRimBrush" Color="#0B0C10" />

    <SolidColorBrush x:Key="TextBrush" Color="#E7E9EF" />
    <SolidColorBrush x:Key="TileTextBrush" Color="#E7E9EF" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#8C92A1" />
    <SolidColorBrush x:Key="ClockBrush" Color="#D3D7E0" />
    <SolidColorBrush x:Key="InverseTextBrush" Color="#F4F5F8" />

    <SolidColorBrush x:Key="TileBorderBrush" Color="#262A33" />
    <SolidColorBrush x:Key="BubbleBorderBrush" Color="#333844" />
    <LinearGradientBrush x:Key="TileBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#191B21" Offset="0" />
        <GradientStop Color="#141619" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="EmptyTileBrush" Color="#80121418" />
    <SolidColorBrush x:Key="EmptyTileBorderBrush" Color="#1C1F26" />
    <SolidColorBrush x:Key="GlossBrush" Color="#00FFFFFF" />

    <SolidColorBrush x:Key="BarBrush" Color="#101216" />
    <SolidColorBrush x:Key="BarLineBrush" Color="#2A2E38" />

    <SolidColorBrush x:Key="PanelBrush" Color="#F2161820" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#272B34" />
    <SolidColorBrush x:Key="CardBrush" Color="#1B1E25" />

    <SolidColorBrush x:Key="ButtonBrush" Color="#1C1F26" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#2E323C" />
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#DADDE5" />
    <SolidColorBrush x:Key="TrackBrush" Color="#252932" />
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#B3000000" />

    <SolidColorBrush x:Key="HeaderBrush" Color="#F2111318" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#5BD69A" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF7A88" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F4C06A" />

    <SolidColorBrush x:Key="PointerFillBrush" Color="#F4F5F8" />
    <SolidColorBrush x:Key="PointerOutlineBrush" Color="#3A4260" />
    <SolidColorBrush x:Key="PointerShadowBrush" Color="#000000" />
    <SolidColorBrush x:Key="PointerCuffBrush" Color="#8EA6FF" />
    <RadialGradientBrush x:Key="SplashGlowBrush">
        <GradientStop Color="#338EA6FF" Offset="0" />
        <GradientStop Color="#008EA6FF" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="QuickScrimBrush" Color="#C7050608" />
    <SolidColorBrush x:Key="QuickTopBrush" Color="#F5121419" />
    <SolidColorBrush x:Key="QuickTopLineBrush" Color="#8EA6FF" />
    <SolidColorBrush x:Key="QuickBottomBrush" Color="#F50D0E12" />
    <SolidColorBrush x:Key="QuickTextBrush" Color="#E7E9EF" />

    <DataTemplate x:Key="BackgroundDecorTemplate">
        <Grid ClipToBounds="True">
            <Viewbox Stretch="UniformToFill">
                <Canvas Width="1920" Height="1080">
                    <Ellipse Canvas.Left="-520" Canvas.Top="-560" Width="1500" Height="1300" c:IdleAnim.Kind="Breathe" c:IdleAnim.Duration="9">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#2E5B6CFF" Offset="0" />
                                <GradientStop Color="#005B6CFF" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Canvas.Left="1100" Canvas.Top="300" Width="1300" Height="1100" c:IdleAnim.Kind="Breathe" c:IdleAnim.Duration="12">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#1F3FC8B8" Offset="0" />
                                <GradientStop Color="#003FC8B8" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                </Canvas>
            </Viewbox>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="TileDecorTemplate"><Grid /></DataTemplate>

    <!-- ============================================================ built-in channel art -->
    <Style x:Key="MidArtLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontSize" Value="38" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#E7E9EF" />
    </Style>
    <Style x:Key="MidArtCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Foreground" Value="#8C92A1" />
    </Style>
    <LinearGradientBrush x:Key="MidArtBack" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1B1E25" Offset="0" />
        <GradientStop Color="#131519" Offset="1" />
    </LinearGradientBrush>

    <DataTemplate x:Key="Art.files">
        <Viewbox Stretch="UniformToFill">
            <Canvas Width="400" Height="240" ClipToBounds="True">
                <Rectangle Width="400" Height="240" Fill="{StaticResource MidArtBack}" />
                <Ellipse Canvas.Left="180" Canvas.Top="-80" Width="300" Height="300"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#338EA6FF" Offset="0" /><GradientStop Color="#008EA6FF" Offset="1" /></RadialGradientBrush></Ellipse.Fill></Ellipse>
                <Border Canvas.Left="240" Canvas.Top="40" Width="126" Height="126" CornerRadius="30" Background="#228EA6FF" BorderBrush="#558EA6FF" BorderThickness="2" c:IdleAnim.Kind="Bob">
                    <Path Margin="30" Stretch="Uniform" Stroke="#B4C3FF" StrokeThickness="6" StrokeLineJoin="Round" Data="M 4,14 L 4,62 L 76,62 L 76,24 L 38,24 L 30,12 L 4,12 Z" />
                </Border>
                <TextBlock Canvas.Left="28" Canvas.Top="24" Text="Browse your drives" Style="{StaticResource MidArtCaption}" />
                <TextBlock Canvas.Left="26" Canvas.Top="170" Text="Files" Style="{StaticResource MidArtLabel}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="Art.photos">
        <Viewbox Stretch="UniformToFill">
            <Canvas Width="400" Height="240" ClipToBounds="True">
                <Rectangle Width="400" Height="240" Fill="{StaticResource MidArtBack}" />
                <Ellipse Canvas.Left="180" Canvas.Top="-80" Width="300" Height="300"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#33F28FAD" Offset="0" /><GradientStop Color="#00F28FAD" Offset="1" /></RadialGradientBrush></Ellipse.Fill></Ellipse>
                <Border Canvas.Left="240" Canvas.Top="40" Width="126" Height="126" CornerRadius="30" Background="#22F28FAD" BorderBrush="#55F28FAD" BorderThickness="2">
                    <Grid Margin="28">
                        <Path Stretch="Uniform" Stroke="#F7B3C8" StrokeThickness="6" StrokeLineJoin="Round" Data="M 4,8 L 76,8 L 76,64 L 4,64 Z M 6,54 L 28,32 L 44,48 L 56,38 L 76,56" />
                        <Ellipse Width="12" Height="12" Fill="#F7B3C8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" c:IdleAnim.Kind="Pulse" />
                    </Grid>
                </Border>
                <TextBlock Canvas.Left="28" Canvas.Top="24" Text="Your pictures" Style="{StaticResource MidArtCaption}" />
                <TextBlock Canvas.Left="26" Canvas.Top="170" Text="Photos" Style="{StaticResource MidArtLabel}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="Art.browser">
        <Viewbox Stretch="UniformToFill">
            <Canvas Width="400" Height="240" ClipToBounds="True">
                <Rectangle Width="400" Height="240" Fill="{StaticResource MidArtBack}" />
                <Ellipse Canvas.Left="180" Canvas.Top="-80" Width="300" Height="300"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#336FD3C7" Offset="0" /><GradientStop Color="#006FD3C7" Offset="1" /></RadialGradientBrush></Ellipse.Fill></Ellipse>
                <Border Canvas.Left="240" Canvas.Top="40" Width="126" Height="126" CornerRadius="30" Background="#226FD3C7" BorderBrush="#556FD3C7" BorderThickness="2">
                    <Path Margin="28" Stretch="Uniform" Stroke="#9BE4DA" StrokeThickness="6" StrokeLineJoin="Round" Data="M 40,4 A 36,36 0 1 1 39.9,4 Z M 4,40 L 76,40 M 40,4 C 22,24 22,56 40,76 C 58,56 58,24 40,4" c:IdleAnim.Kind="Sway" />
                </Border>
                <TextBlock Canvas.Left="28" Canvas.Top="24" Text="Search and bookmarks" Style="{StaticResource MidArtCaption}" />
                <TextBlock Canvas.Left="26" Canvas.Top="170" Text="Web" Style="{StaticResource MidArtLabel}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="Art.customize">
        <Viewbox Stretch="UniformToFill">
            <Canvas Width="400" Height="240" ClipToBounds="True">
                <Rectangle Width="400" Height="240" Fill="{StaticResource MidArtBack}" />
                <Ellipse Canvas.Left="180" Canvas.Top="-80" Width="300" Height="300"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#33C3A6FF" Offset="0" /><GradientStop Color="#00C3A6FF" Offset="1" /></RadialGradientBrush></Ellipse.Fill></Ellipse>
                <Border Canvas.Left="240" Canvas.Top="40" Width="126" Height="126" CornerRadius="30" Background="#22C3A6FF" BorderBrush="#55C3A6FF" BorderThickness="2">
                    <Canvas Width="80" Height="72">
                        <Path Stroke="#D6C5FF" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 4,12 L 76,12 M 4,36 L 76,36 M 4,60 L 76,60" />
                        <Ellipse Canvas.Left="40" Canvas.Top="3" Width="18" Height="18" Fill="#1B1E25" Stroke="#D6C5FF" StrokeThickness="5" c:IdleAnim.Kind="Float" c:IdleAnim.Distance="-26" c:IdleAnim.Duration="3.2" />
                        <Ellipse Canvas.Left="14" Canvas.Top="27" Width="18" Height="18" Fill="#1B1E25" Stroke="#D6C5FF" StrokeThickness="5" c:IdleAnim.Kind="Float" c:IdleAnim.Distance="34" c:IdleAnim.Duration="3.8" />
                        <Ellipse Canvas.Left="52" Canvas.Top="51" Width="18" Height="18" Fill="#1B1E25" Stroke="#D6C5FF" StrokeThickness="5" c:IdleAnim.Kind="Float" c:IdleAnim.Distance="-38" c:IdleAnim.Duration="2.9" />
                    </Canvas>
                </Border>
                <TextBlock Canvas.Left="28" Canvas.Top="24" Text="Arrange your channels" Style="{StaticResource MidArtCaption}" />
                <TextBlock Canvas.Left="26" Canvas.Top="170" Text="Customize" Style="{StaticResource MidArtLabel}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="Art.settings">
        <Viewbox Stretch="UniformToFill">
            <Canvas Width="400" Height="240" ClipToBounds="True">
                <Rectangle Width="400" Height="240" Fill="{StaticResource MidArtBack}" />
                <Ellipse Canvas.Left="180" Canvas.Top="-80" Width="300" Height="300"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#26A0A7B4" Offset="0" /><GradientStop Color="#00A0A7B4" Offset="1" /></RadialGradientBrush></Ellipse.Fill></Ellipse>
                <Border Canvas.Left="240" Canvas.Top="40" Width="126" Height="126" CornerRadius="30" Background="#1FA0A7B4" BorderBrush="#4DA0A7B4" BorderThickness="2">
                    <Viewbox Margin="26" c:IdleAnim.Kind="Spin">
                        <Canvas Width="80" Height="80">
                            <Path Stroke="#C9CEDA" StrokeThickness="13" Data="M 40,18 L 40,5 M 40,62 L 40,75 M 62,40 L 75,40 M 18,40 L 5,40 M 55.5,24.5 L 64.7,15.3 M 55.5,55.5 L 64.7,64.7 M 24.5,55.5 L 15.3,64.7 M 24.5,24.5 L 15.3,15.3" />
                            <Ellipse Canvas.Left="14" Canvas.Top="14" Width="52" Height="52" Stroke="#C9CEDA" StrokeThickness="9" Fill="#1B1E25" />
                            <Ellipse Canvas.Left="31" Canvas.Top="31" Width="18" Height="18" Stroke="#C9CEDA" StrokeThickness="6" />
                        </Canvas>
                    </Viewbox>
                </Border>
                <TextBlock Canvas.Left="28" Canvas.Top="24" Text="System preferences" Style="{StaticResource MidArtCaption}" />
                <TextBlock Canvas.Left="26" Canvas.Top="170" Text="Settings" Style="{StaticResource MidArtLabel}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="Art.sports">
        <Viewbox Stretch="UniformToFill">
            <Canvas Width="400" Height="240" ClipToBounds="True">
                <Rectangle Width="400" Height="240" Fill="{StaticResource MidArtBack}" />
                <Ellipse Canvas.Left="180" Canvas.Top="-80" Width="300" Height="300"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#338FD98A" Offset="0" /><GradientStop Color="#008FD98A" Offset="1" /></RadialGradientBrush></Ellipse.Fill></Ellipse>
                <Border Canvas.Left="240" Canvas.Top="40" Width="126" Height="126" CornerRadius="30" Background="#228FD98A" BorderBrush="#558FD98A" BorderThickness="2" c:IdleAnim.Kind="Bob">
                    <Path Margin="28" Stretch="Uniform" Stroke="#B8EDB3" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 40,4 A 36,36 0 1 1 39.9,4 Z M 12,16 Q 40,40 12,66 M 68,14 Q 40,40 68,66" />
                </Border>
                <TextBlock Canvas.Left="28" Canvas.Top="24" Text="Coming soon · work in progress" Style="{StaticResource MidArtCaption}" />
                <TextBlock Canvas.Left="26" Canvas.Top="170" Text="Sports" Style="{StaticResource MidArtLabel}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="Art.power">
        <Viewbox Stretch="UniformToFill">
            <Canvas Width="400" Height="240" ClipToBounds="True">
                <Rectangle Width="400" Height="240" Fill="{StaticResource MidArtBack}" />
                <Ellipse Canvas.Left="180" Canvas.Top="-80" Width="300" Height="300"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#33FF7A88" Offset="0" /><GradientStop Color="#00FF7A88" Offset="1" /></RadialGradientBrush></Ellipse.Fill></Ellipse>
                <Border Canvas.Left="240" Canvas.Top="40" Width="126" Height="126" CornerRadius="30" Background="#22FF7A88" BorderBrush="#55FF7A88" BorderThickness="2" c:IdleAnim.Kind="Pulse">
                    <Path Margin="30" Stretch="Uniform" Stroke="#FFA3AD" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 24,16 A 30,30 0 1 0 56,16 M 40,4 L 40,38" />
                </Border>
                <TextBlock Canvas.Left="28" Canvas.Top="24" Text="Sleep, restart, sign out" Style="{StaticResource MidArtCaption}" />
                <TextBlock Canvas.Left="26" Canvas.Top="170" Text="Power" Style="{StaticResource MidArtLabel}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>
</ResourceDictionary>
