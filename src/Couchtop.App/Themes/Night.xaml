<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Night: the dim slate look of the console's settings screens. -->

    <FontFamily x:Key="AppFont">/Couchtop;component/Assets/Fonts/#Rounded Mplus 1c, Segoe UI</FontFamily>
    <CornerRadius x:Key="PillCornerRadius">42</CornerRadius>
    <CornerRadius x:Key="PillGlowCornerRadius">48</CornerRadius>
    <CornerRadius x:Key="PillGlossCornerRadius">38,38,16,16</CornerRadius>
    <CornerRadius x:Key="RoundCornerRadius">999</CornerRadius>
    <CornerRadius x:Key="TileCornerRadius">26</CornerRadius>
    <CornerRadius x:Key="TileGlowCornerRadius">34</CornerRadius>
    <CornerRadius x:Key="TileGlossCornerRadius">20,20,90,90</CornerRadius>
    <CornerRadius x:Key="PanelCornerRadius">44</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">34</CornerRadius>
    <CornerRadius x:Key="ItemCornerRadius">26</CornerRadius>
    <CornerRadius x:Key="InputCornerRadius">36</CornerRadius>
    <CornerRadius x:Key="TrackCornerRadius">9</CornerRadius>
    <Thickness x:Key="PillBorderThickness">4</Thickness>
    <Thickness x:Key="RoundBorderThickness">5</Thickness>
    <Thickness x:Key="TileBorderThickness">4</Thickness>
    <Thickness x:Key="PanelBorderThickness">4</Thickness>
    <sys:Double x:Key="TileClipRadius">20</sys:Double>
    <sys:Double x:Key="TileChamfer">0</sys:Double>
    <sys:Double x:Key="TileGlossOpacity">0.5</sys:Double>
    <Color x:Key="CardMixColor">#FFFFFF</Color>
    <sys:Double x:Key="CardMixTop">0.86</sys:Double>
    <sys:Double x:Key="CardMixBottom">0.62</sys:Double>
    <Color x:Key="BarShadowColor">#000000</Color>
    <sys:Double x:Key="BarShadowOpacity">0.3</sys:Double>

    <Color x:Key="AccentColor">#3CC2F2</Color>
    <Color x:Key="AccentDeepColor">#5ACFF7</Color>
    <Color x:Key="TileBorderColor">#4B575F</Color>
    <Color x:Key="ButtonBorderColor">#58656D</Color>
    <Color x:Key="ButtonTextColor">#D5DDE1</Color>

    <LinearGradientBrush x:Key="BackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2B353B" Offset="0" />
        <GradientStop Color="#1C2328" Offset="0.6" />
        <GradientStop Color="#12171A" Offset="1" />
    </LinearGradientBrush>
    <DrawingBrush x:Key="StripeBrush" TileMode="Tile" Viewport="0,0,1,7" ViewportUnits="Absolute" Viewbox="0,0,1,7" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#0DFFFFFF" Geometry="M0,0 H1 V1 H0 Z" />
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <SolidColorBrush x:Key="AccentBrush" Color="#3CC2F2" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="#5ACFF7" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#803CC2F2" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F4E61" />
    <SolidColorBrush x:Key="TileGlowBrush" Color="#803CC2F2" />
    <SolidColorBrush x:Key="BadgeRimBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="TextBrush" Color="#D5DDE1" />
    <SolidColorBrush x:Key="TileTextBrush" Color="#4A575F" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#9AA7AE" />
    <SolidColorBrush x:Key="ClockBrush" Color="#8594A0" />
    <SolidColorBrush x:Key="InverseTextBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="TileBorderBrush" Color="#4B575F" />
    <SolidColorBrush x:Key="BubbleBorderBrush" Color="#4B575F" />
    <LinearGradientBrush x:Key="TileBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3C474E" Offset="0" />
        <GradientStop Color="#2D363C" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmptyTileBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#20272B" Offset="0" />
        <GradientStop Color="#283035" Offset="0.3" />
        <GradientStop Color="#2B3338" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="EmptyTileBorderBrush" Color="#3A454C" />
    <LinearGradientBrush x:Key="GlossBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#40FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#36424A" Offset="0" />
        <GradientStop Color="#283138" Offset="0.5" />
        <GradientStop Color="#1D2429" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BarLineBrush" Color="#2F8DB5" />

    <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#343F46" Offset="0" />
        <GradientStop Color="#283137" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#4B575F" />
    <SolidColorBrush x:Key="CardBrush" Color="#2B343A" />

    <LinearGradientBrush x:Key="ButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#46525A" Offset="0" />
        <GradientStop Color="#3A454C" Offset="0.5" />
        <GradientStop Color="#2F383E" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#58656D" />
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#D5DDE1" />
    <SolidColorBrush x:Key="TrackBrush" Color="#1E252A" />
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#99000000" />

    <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#36424A" Offset="0" />
        <GradientStop Color="#283138" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SuccessBrush" Color="#6ECF4E" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F06B83" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F2B34E" />

    <LinearGradientBrush x:Key="PointerFillBrush" StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#FFFFFF" Offset="0.45" />
        <GradientStop Color="#C9E4F8" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PointerOutlineBrush" Color="#1B6FB8" />
    <SolidColorBrush x:Key="PointerShadowBrush" Color="#000000" />
    <SolidColorBrush x:Key="PointerCuffBrush" Color="#E8F3FB" />
    <RadialGradientBrush x:Key="SplashGlowBrush">
        <GradientStop Color="#443CC2F2" Offset="0" />
        <GradientStop Color="#003CC2F2" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="QuickScrimBrush" Color="#B3000000" />
    <LinearGradientBrush x:Key="QuickTopBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F236424A" Offset="0" />
        <GradientStop Color="#F21D2429" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="QuickTopLineBrush" Color="#2F8DB5" />
    <SolidColorBrush x:Key="QuickBottomBrush" Color="#F0141A1E" />
    <SolidColorBrush x:Key="QuickTextBrush" Color="#E8EEF1" />

    <DataTemplate x:Key="BackgroundDecorTemplate"><Grid /></DataTemplate>
    <DataTemplate x:Key="TileDecorTemplate"><Grid /></DataTemplate>
</ResourceDictionary>
