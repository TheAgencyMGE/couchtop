    <DataTemplate x:Key="TileDecorTemplate"><Grid /></DataTemplate>

    <!-- ============================================================ built-in channel art: icons inside glass orbs -->

    <Style x:Key="SkyArtLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="42" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- A colored glass orb. Background is the tint; the content is a white glyph sealed inside. -->
    <Style x:Key="SkyGlassOrb" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox>
                        <Grid Width="100" Height="100">
                            <Ellipse Margin="6,90,6,-6" Height="12" VerticalAlignment="Top" Fill="#330A3A66" />
                            <Ellipse Fill="{TemplateBinding Background}" />
                            <Ellipse>
                                <Ellipse.Fill>
                                    <RadialGradientBrush GradientOrigin="0.5,0.85" Center="0.5,0.6" RadiusX="0.6" RadiusY="0.6">
                                        <GradientStop Color="#59FFFFFF" Offset="0" />
                                        <GradientStop Color="#00FFFFFF" Offset="0.55" />
                                        <GradientStop Color="#40002850" Offset="1" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <ContentPresenter Margin="25" />
                            <Ellipse Stroke="#F2FFFFFF" StrokeThickness="1.6" />
                            <Canvas>
                                <Path Data="M 13,44 C 13,22 30,8 54,7 C 36,14 23,27 21,46 C 19,53 13,52 13,44 Z">
                                    <Path.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                                            <GradientStop Color="#40FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                </Path>
                                <Ellipse Canvas.Left="60" Canvas.Top="12" Width="12" Height="7" Fill="#E6FFFFFF" />
                                <Path Data="M 22,82 A 34,34 0 0 0 80,76" Stroke="#B3FFFFFF" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                        </Grid>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <RadialGradientBrush x:Key="OrbAmber" GradientOrigin="0.4,0.3"><GradientStop Color="#99FFE27A" Offset="0" /><GradientStop Color="#CCF2A515" Offset="1" /></RadialGradientBrush>
    <RadialGradientBrush x:Key="OrbPink" GradientOrigin="0.4,0.3"><GradientStop Color="#99FFB3D9" Offset="0" /><GradientStop Color="#CCE8418F" Offset="1" /></RadialGradientBrush>
    <RadialGradientBrush x:Key="OrbBlue" GradientOrigin="0.4,0.3"><GradientStop Color="#9987D6FF" Offset="0" /><GradientStop Color="#CC0A6FE0" Offset="1" /></RadialGradientBrush>
    <RadialGradientBrush x:Key="OrbLime" GradientOrigin="0.4,0.3"><GradientStop Color="#99D8FF8A" Offset="0" /><GradientStop Color="#CC45B51C" Offset="1" /></RadialGradientBrush>
    <RadialGradientBrush x:Key="OrbSilver" GradientOrigin="0.4,0.3"><GradientStop Color="#99E6F4FF" Offset="0" /><GradientStop Color="#CC5E8FB5" Offset="1" /></RadialGradientBrush>
    <RadialGradientBrush x:Key="OrbRed" GradientOrigin="0.4,0.3"><GradientStop Color="#99FFB0A6" Offset="0" /><GradientStop Color="#CCE23B3B" Offset="1" /></RadialGradientBrush>

    <!-- Soft glassy wash inside each built-in tile so the frame's see-through body stays readable -->
    <LinearGradientBrush x:Key="SkyArtWash" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#40FFFFFF" Offset="0" />
        <GradientStop Color="#0DFFFFFF" Offset="0.55" />
        <GradientStop Color="#26BFEFFF" Offset="1" />
    </LinearGradientBrush>

