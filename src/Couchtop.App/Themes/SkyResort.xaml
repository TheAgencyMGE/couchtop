<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:c="clr-namespace:Couchtop.App.Controls">
    <!--
        Sky Resort: late-2000s "glass and nature" optimism. Deep blue sky fading to a hazy horizon, a turquoise
        sea and green island hills, soft clouds, aurora ribbons, a sun flare, and glossy glass orbs drifting up.
        Controls are aqua gel: white glass with strong top highlights and sky-blue rims. All artwork is original.
    -->

    <FontFamily x:Key="AppFont">/Couchtop;component/Assets/Fonts/#Rounded Mplus 1c, Segoe UI</FontFamily>
    <CornerRadius x:Key="PillCornerRadius">42</CornerRadius>
    <CornerRadius x:Key="PillGlowCornerRadius">48</CornerRadius>
    <CornerRadius x:Key="PillGlossCornerRadius">38,38,20,20</CornerRadius>
    <CornerRadius x:Key="RoundCornerRadius">999</CornerRadius>
    <CornerRadius x:Key="TileCornerRadius">30</CornerRadius>
    <CornerRadius x:Key="TileGlowCornerRadius">38</CornerRadius>
    <CornerRadius x:Key="TileGlossCornerRadius">24,24,120,120</CornerRadius>
    <CornerRadius x:Key="PanelCornerRadius">46</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">36</CornerRadius>
    <CornerRadius x:Key="ItemCornerRadius">28</CornerRadius>
    <CornerRadius x:Key="InputCornerRadius">36</CornerRadius>
    <CornerRadius x:Key="TrackCornerRadius">9</CornerRadius>
    <Thickness x:Key="PillBorderThickness">4</Thickness>
    <Thickness x:Key="RoundBorderThickness">5</Thickness>
    <Thickness x:Key="TileBorderThickness">4</Thickness>
    <Thickness x:Key="PanelBorderThickness">4</Thickness>
    <sys:Double x:Key="TileClipRadius">24</sys:Double>
    <sys:Double x:Key="TileChamfer">0</sys:Double>
    <sys:Double x:Key="TileGlossOpacity">0.85</sys:Double>
    <Color x:Key="CardMixColor">#FFFFFF</Color>
    <sys:Double x:Key="CardMixTop">0.78</sys:Double>
    <sys:Double x:Key="CardMixBottom">0.5</sys:Double>
    <Color x:Key="BarShadowColor">#0B5E99</Color>
    <sys:Double x:Key="BarShadowOpacity">0.35</sys:Double>

    <Color x:Key="AccentColor">#0EA5E9</Color>
    <Color x:Key="AccentDeepColor">#0B74C4</Color>
    <Color x:Key="TileBorderColor">#A9DDF5</Color>
    <Color x:Key="ButtonBorderColor">#8CCFEE</Color>
    <Color x:Key="ButtonTextColor">#185A86</Color>

    <LinearGradientBrush x:Key="BackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0B78D8" Offset="0" />
        <GradientStop Color="#2E9BEB" Offset="0.22" />
        <GradientStop Color="#76C9F5" Offset="0.48" />
        <GradientStop Color="#CBEFFD" Offset="0.62" />
        <GradientStop Color="#EFFBFF" Offset="0.66" />
        <GradientStop Color="#3CC6DE" Offset="0.68" />
        <GradientStop Color="#118DC2" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="StripeBrush" Color="#00000000" />

    <SolidColorBrush x:Key="AccentBrush" Color="#0EA5E9" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="#0B74C4" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#9954E6FF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#D5F1FD" />
    <SolidColorBrush x:Key="TileGlowBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="BadgeRimBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="TextBrush" Color="#1D4E73" />
    <SolidColorBrush x:Key="TileTextBrush" Color="#1D4E73" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#5B86A6" />
    <SolidColorBrush x:Key="ClockBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InverseTextBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="TileBorderBrush" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="BubbleBorderBrush" Color="#8CCFEE" />
    <LinearGradientBrush x:Key="TileBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#DDF3FD" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EmptyTileBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#40FFFFFF" Offset="0" />
        <GradientStop Color="#1FFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="EmptyTileBorderBrush" Color="#80FFFFFF" />
    <LinearGradientBrush x:Key="GlossBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2FFFFFF" Offset="0" />
        <GradientStop Color="#80FFFFFF" Offset="0.45" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F7FFFFFF" Offset="0" />
        <GradientStop Color="#E4F5FD" Offset="0.45" />
        <GradientStop Color="#BFE6F8" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BarLineBrush" Color="#FFFFFF" />

    <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FAFFFFFF" Offset="0" />
        <GradientStop Color="#F0E6F6FD" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBrush" Color="#F2FAFE" />

    <LinearGradientBrush x:Key="ButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#E6F7FF" Offset="0.5" />
        <GradientStop Color="#B8E4FA" Offset="0.51" />
        <GradientStop Color="#D9F2FD" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#8CCFEE" />
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#185A86" />
    <SolidColorBrush x:Key="TrackBrush" Color="#C6E7F6" />
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#66093A5C" />

    <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F7FFFFFF" Offset="0" />
        <GradientStop Color="#E3F5FD" Offset="0.5" />
        <GradientStop Color="#C9EBFA" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SuccessBrush" Color="#5CC72E" />
    <SolidColorBrush x:Key="DangerBrush" Color="#EF5A6F" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F4A627" />

    <LinearGradientBrush x:Key="PointerFillBrush" StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#FFFFFF" Offset="0.45" />
        <GradientStop Color="#BDE8FB" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PointerOutlineBrush" Color="#0B74C4" />
    <SolidColorBrush x:Key="PointerShadowBrush" Color="#063B66" />
    <SolidColorBrush x:Key="PointerCuffBrush" Color="#DFF4FD" />
    <RadialGradientBrush x:Key="SplashGlowBrush">
        <GradientStop Color="#99FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="QuickScrimBrush" Color="#8C052B4A" />
    <LinearGradientBrush x:Key="QuickTopBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F24FC3F7" Offset="0" />
        <GradientStop Color="#F21B9AE4" Offset="0.5" />
        <GradientStop Color="#F20B72C6" Offset="0.51" />
        <GradientStop Color="#F21087D6" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="QuickTopLineBrush" Color="#F2FFFFFF" />
    <LinearGradientBrush x:Key="QuickBottomBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E60D5A8F" Offset="0" />
        <GradientStop Color="#F2083A60" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="QuickTextBrush" Color="#FFFFFF" />

    <!-- A glass orb: faint body, bright rim, crescent highlight and a refracted glint. -->
    <DataTemplate x:Key="SkyOrb">
        <Viewbox>
            <Canvas Width="100" Height="100">
                <Ellipse Width="100" Height="100" StrokeThickness="1.6" Stroke="#CCFFFFFF">
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.5,0.62" Center="0.5,0.55" RadiusX="0.55" RadiusY="0.55">
                            <GradientStop Color="#0AFFFFFF" Offset="0" />
                            <GradientStop Color="#1FBFF3FF" Offset="0.7" />
                            <GradientStop Color="#8CFFFFFF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Path Data="M 16,44 C 16,24 32,10 54,9 C 38,15 26,28 24,46 C 22,52 16,52 16,44 Z">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F2FFFFFF" Offset="0" />
                            <GradientStop Color="#33FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
                <Ellipse Canvas.Left="30" Canvas.Top="14" Width="12" Height="8" Fill="#E6FFFFFF" />
                <Path Data="M 24,78 A 34,34 0 0 0 80,70" Stroke="#80FFFFFF" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Ellipse Canvas.Left="72" Canvas.Top="58" Width="7" Height="7" Fill="#99FFFFFF" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="SkyCloud">
        <Canvas Width="420" Height="150">
            <Ellipse Canvas.Left="0" Canvas.Top="70" Width="190" Height="80" Fill="#D9FFFFFF" />
            <Ellipse Canvas.Left="80" Canvas.Top="24" Width="170" Height="120" Fill="#E6FFFFFF" />
            <Ellipse Canvas.Left="190" Canvas.Top="0" Width="150" Height="140" Fill="#F2FFFFFF" />
            <Ellipse Canvas.Left="280" Canvas.Top="60" Width="140" Height="90" Fill="#D9FFFFFF" />
            <Rectangle Canvas.Left="60" Canvas.Top="100" Width="320" Height="50" RadiusX="25" RadiusY="25" Fill="#E6FFFFFF" />
        </Canvas>
    </DataTemplate>

    <DataTemplate x:Key="BackgroundDecorTemplate">
        <Grid ClipToBounds="True">
            <Viewbox Stretch="UniformToFill">
                <Canvas Width="1920" Height="1080">
                    <!-- Sun and lens flare -->
                    <Ellipse Canvas.Left="1180" Canvas.Top="-620" Width="1300" Height="1300">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#F2FFFFFF" Offset="0" />
                                <GradientStop Color="#99FFFFFF" Offset="0.12" />
                                <GradientStop Color="#33E0F7FF" Offset="0.42" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Canvas.Left="1606" Canvas.Top="-24" Width="88" Height="88" Fill="#FFFFFF" c:IdleAnim.Kind="Breathe" c:IdleAnim.Duration="6" />
                    <Ellipse Canvas.Left="1400" Canvas.Top="170" Width="70" Height="70" Fill="#14FFFFFF" Stroke="#40FFFFFF" StrokeThickness="2" />
                    <Ellipse Canvas.Left="1300" Canvas.Top="262" Width="26" Height="26" Fill="#33FFFFFF" />
                    <Ellipse Canvas.Left="1090" Canvas.Top="380" Width="140" Height="140" Fill="#0FBDF7FF" Stroke="#26FFFFFF" StrokeThickness="2" />

                    <!-- Aurora ribbons -->
                    <Path Data="M -100,430 C 380,250 900,560 1400,330 C 1700,200 1900,300 2050,250 L 2050,320 C 1900,370 1700,290 1400,420 C 900,640 380,340 -100,520 Z"
                          c:IdleAnim.Kind="Float" c:IdleAnim.Distance="90" c:IdleAnim.Duration="26">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                <GradientStop Color="#66FFFFFF" Offset="0.3" />
                                <GradientStop Color="#4DB6FFD9" Offset="0.6" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                    <Path Data="M -100,250 C 500,120 1000,330 1500,160 C 1750,80 1900,120 2050,90 L 2050,120 C 1900,160 1750,120 1500,205 C 1000,380 500,170 -100,290 Z"
                          c:IdleAnim.Kind="Float" c:IdleAnim.Distance="-70" c:IdleAnim.Duration="32">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                <GradientStop Color="#4DFFFFFF" Offset="0.45" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>

                    <!-- Clouds -->
                    <ContentControl Content="c" ContentTemplate="{StaticResource SkyCloud}" Canvas.Left="-120" Canvas.Top="-40" Opacity="0.95" c:IdleAnim.Kind="Float" c:IdleAnim.Distance="70" c:IdleAnim.Duration="38" />
                    <ContentControl Content="c" ContentTemplate="{StaticResource SkyCloud}" Canvas.Left="760" Canvas.Top="-78" Opacity="0.7" c:IdleAnim.Kind="Float" c:IdleAnim.Distance="-90" c:IdleAnim.Duration="46">
                        <ContentControl.LayoutTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8" /></ContentControl.LayoutTransform>
                    </ContentControl>
                    <ContentControl Content="c" ContentTemplate="{StaticResource SkyCloud}" Canvas.Left="1640" Canvas.Top="300" Opacity="0.85" c:IdleAnim.Kind="Float" c:IdleAnim.Distance="-60" c:IdleAnim.Duration="40">
                        <ContentControl.LayoutTransform><ScaleTransform ScaleX="0.7" ScaleY="0.7" /></ContentControl.LayoutTransform>
                    </ContentControl>
                    <ContentControl Content="c" ContentTemplate="{StaticResource SkyCloud}" Canvas.Left="-160" Canvas.Top="480" Opacity="0.75" c:IdleAnim.Kind="Float" c:IdleAnim.Distance="50" c:IdleAnim.Duration="36">
                        <ContentControl.LayoutTransform><ScaleTransform ScaleX="0.65" ScaleY="0.65" /></ContentControl.LayoutTransform>
                    </ContentControl>

                    <!-- Sea shimmer along the horizon -->
                    <Rectangle Canvas.Top="712" Width="1920" Height="4" Fill="#99FFFFFF" />
                    <Rectangle Canvas.Left="40" Canvas.Top="740" Width="70" Height="4" RadiusX="2" RadiusY="2" Fill="#CCFFFFFF" c:IdleAnim.Kind="Twinkle" />
                    <Rectangle Canvas.Left="1790" Canvas.Top="752" Width="90" Height="4" RadiusX="2" RadiusY="2" Fill="#CCFFFFFF" c:IdleAnim.Kind="Twinkle" />
                    <Rectangle Canvas.Left="545" Canvas.Top="790" Width="60" Height="4" RadiusX="2" RadiusY="2" Fill="#B3FFFFFF" c:IdleAnim.Kind="Twinkle" />
                    <Rectangle Canvas.Left="1340" Canvas.Top="784" Width="50" Height="4" RadiusX="2" RadiusY="2" Fill="#B3FFFFFF" c:IdleAnim.Kind="Twinkle" />

                    <!-- Island hills with a palm -->
                    <Path Data="M -60,1080 L -60,700 C 60,640 190,650 300,730 C 350,766 390,800 430,860 L 430,1080 Z">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#9BE35F" Offset="0" />
                                <GradientStop Color="#45B03A" Offset="0.6" />
                                <GradientStop Color="#2F8A2E" Offset="1" />
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                    <Path Data="M -60,700 C 60,640 190,650 300,730" Stroke="#66FFFFFF" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path Data="M 1560,1080 C 1620,800 1760,700 1990,740 L 1990,1080 Z">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#F4E1A6" Offset="0" />
                                <GradientStop Color="#8ED957" Offset="0.18" />
                                <GradientStop Color="#3A9F36" Offset="1" />
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                    <Path Data="M 1850,740 C 1838,660 1852,590 1880,540" Stroke="#9A6B3D" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Canvas Canvas.Left="1880" Canvas.Top="540" c:IdleAnim.Kind="Sway">
                        <Path Fill="#3FAE3C" Data="M 0,0 C -40,-30 -90,-20 -120,20 C -80,0 -40,0 0,0 Z" />
                        <Path Fill="#56C447" Data="M 0,0 C -30,-60 -80,-70 -110,-50 C -60,-45 -30,-30 0,0 Z" />
                        <Path Fill="#3FAE3C" Data="M 0,0 C 20,-60 70,-70 100,-40 C 60,-40 30,-30 0,0 Z" />
                        <Path Fill="#56C447" Data="M 0,0 C 40,-20 90,-10 110,30 C 70,10 40,5 0,0 Z" />
                        <Ellipse Canvas.Left="-10" Canvas.Top="-6" Width="16" Height="16" Fill="#8B5A2B" />
                    </Canvas>

                    <!-- Glass orbs rising -->
                    <ContentControl Content="o" ContentTemplate="{StaticResource SkyOrb}" Canvas.Left="30" Canvas.Top="560" Width="110" Height="110" c:IdleAnim.Kind="Rise" c:IdleAnim.Distance="1080" c:IdleAnim.Duration="34" />
                    <ContentControl Content="o" ContentTemplate="{StaticResource SkyOrb}" Canvas.Left="96" Canvas.Top="250" Width="46" Height="46" c:IdleAnim.Kind="Rise" c:IdleAnim.Distance="1080" c:IdleAnim.Duration="22" />
                    <ContentControl Content="o" ContentTemplate="{StaticResource SkyOrb}" Canvas.Left="1780" Canvas.Top="420" Width="130" Height="130" c:IdleAnim.Kind="Rise" c:IdleAnim.Distance="1080" c:IdleAnim.Duration="40" />
                    <ContentControl Content="o" ContentTemplate="{StaticResource SkyOrb}" Canvas.Left="1830" Canvas.Top="120" Width="54" Height="54" c:IdleAnim.Kind="Rise" c:IdleAnim.Distance="1080" c:IdleAnim.Duration="26" />
                    <ContentControl Content="o" ContentTemplate="{StaticResource SkyOrb}" Canvas.Left="520" Canvas.Top="8" Width="40" Height="40" c:IdleAnim.Kind="Rise" c:IdleAnim.Distance="1080" c:IdleAnim.Duration="24" />
                    <ContentControl Content="o" ContentTemplate="{StaticResource SkyOrb}" Canvas.Left="1150" Canvas.Top="266" Width="34" Height="34" c:IdleAnim.Kind="Rise" c:IdleAnim.Distance="1080" c:IdleAnim.Duration="20" />
                    <ContentControl Content="o" ContentTemplate="{StaticResource SkyOrb}" Canvas.Left="908" Canvas.Top="520" Width="30" Height="30" c:IdleAnim.Kind="Rise" c:IdleAnim.Distance="1080" c:IdleAnim.Duration="18" />
                    <ContentControl Content="o" ContentTemplate="{StaticResource SkyOrb}" Canvas.Left="10" Canvas.Top="880" Width="74" Height="74" c:IdleAnim.Kind="Rise" c:IdleAnim.Distance="1080" c:IdleAnim.Duration="30" />
                    <ContentControl Content="o" ContentTemplate="{StaticResource SkyOrb}" Canvas.Left="1700" Canvas.Top="760" Width="64" Height="64" c:IdleAnim.Kind="Rise" c:IdleAnim.Distance="1080" c:IdleAnim.Duration="28" />
                </Canvas>
            </Viewbox>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="TileDecorTemplate"><Grid /></DataTemplate>
</ResourceDictionary>
