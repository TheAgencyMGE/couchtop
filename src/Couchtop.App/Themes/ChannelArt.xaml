<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Couchtop.App.Controls">
    <!--
        Original vector artwork for the built-in channels (400x240 design canvas, same aspect as a tile).
        Elements marked with c:IdleAnim.Kind animate gently while the tile is visible.
    -->

    <Style x:Key="ArtLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="44" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Files -->
    <DataTemplate x:Key="Art.files">
        <Viewbox Stretch="UniformToFill">
            <Canvas Width="400" Height="240" ClipToBounds="True">
                <Rectangle Width="400" Height="240">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#C9ECFB" Offset="0" />
                            <GradientStop Color="#5DB9E8" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Ellipse Canvas.Left="-70" Canvas.Top="110" Width="270" Height="270" Fill="#26FFFFFF" />
                <Ellipse Canvas.Left="280" Canvas.Top="-90" Width="220" Height="220" Fill="#22FFFFFF" />
                <Grid Canvas.Left="176" Canvas.Top="62" Width="190" Height="148" c:IdleAnim.Kind="Bob">
                    <Path Data="M0,20 Q0,8 12,8 L62,8 L78,22 L178,22 Q190,22 190,34 L190,136 Q190,148 178,148 L12,148 Q0,148 0,136 Z" Fill="#D99A22" />
                    <Border Margin="24,0,46,52" Background="White" CornerRadius="6" RenderTransformOrigin="0.5,1">
                        <Border.RenderTransform>
                            <RotateTransform Angle="-7" />
                        </Border.RenderTransform>
                        <StackPanel Margin="14,16,14,0">
                            <Rectangle Height="7" RadiusX="3" RadiusY="3" Fill="#BFE0F0" Margin="0,0,20,8" />
                            <Rectangle Height="7" RadiusX="3" RadiusY="3" Fill="#BFE0F0" Margin="0,0,0,8" />
                            <Rectangle Height="7" RadiusX="3" RadiusY="3" Fill="#BFE0F0" Margin="0,0,34,8" />
                        </StackPanel>
                    </Border>
                    <Border Margin="60,14,14,60" Background="#FFF7E6" CornerRadius="6" RenderTransformOrigin="0.5,1">
                        <Border.RenderTransform>
                            <RotateTransform Angle="8" />
                        </Border.RenderTransform>
                        <Ellipse Width="34" Height="34" Fill="#FF9DB5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" />
                    </Border>
                    <Path Data="M0,56 Q0,44 12,44 L178,44 Q190,44 190,56 L190,136 Q190,148 178,148 L12,148 Q0,148 0,136 Z">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFE08A" Offset="0" />
                                <GradientStop Color="#F4B63A" Offset="1" />
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                    <Path Data="M10,56 Q10,52 16,52 L174,52" Stroke="#80FFFFFF" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Grid>
                <Path Canvas.Left="120" Canvas.Top="150" Data="M10,0 L13,7 L20,10 L13,13 L10,20 L7,13 L0,10 L7,7 Z" Fill="White" c:IdleAnim.Kind="Twinkle" />
                <Path Canvas.Left="358" Canvas.Top="30" Data="M10,0 L13,7 L20,10 L13,13 L10,20 L7,13 L0,10 L7,7 Z" Fill="White" c:IdleAnim.Kind="Twinkle" />
                <TextBlock Canvas.Left="26" Canvas.Top="23" Text="Files" Style="{StaticResource ArtLabel}" Foreground="#3A8FC0" />
                <TextBlock Canvas.Left="24" Canvas.Top="20" Text="Files" Style="{StaticResource ArtLabel}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <!-- Photos -->
    <DataTemplate x:Key="Art.photos">
        <Viewbox Stretch="UniformToFill">
            <Canvas Width="400" Height="240" ClipToBounds="True">
                <Rectangle Width="400" Height="240">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFF4CF" Offset="0" />
                            <GradientStop Color="#FFC25A" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Ellipse Canvas.Left="250" Canvas.Top="-60" Width="240" Height="240" Fill="#33FFFFFF" />
                <Border Canvas.Left="150" Canvas.Top="36" Width="150" Height="160" Background="White" CornerRadius="6" Padding="10,10,10,34" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <RotateTransform Angle="-11" />
                    </Border.RenderTransform>
                    <Grid ClipToBounds="True">
                        <Rectangle Fill="#8FD6F7" />
                        <Ellipse Width="34" Height="34" Fill="#FFE066" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0" />
                        <Ellipse Width="200" Height="90" Fill="#7CCB5B" Margin="-50,0,-20,-50" VerticalAlignment="Bottom" />
                        <Ellipse Width="150" Height="70" Fill="#5DB847" Margin="40,0,-60,-40" VerticalAlignment="Bottom" />
                    </Grid>
                </Border>
                <Border Canvas.Left="230" Canvas.Top="58" Width="140" Height="150" Background="White" CornerRadius="6" Padding="10,10,10,32" c:IdleAnim.Kind="Sway">
                    <Grid ClipToBounds="True">
                        <Rectangle Fill="#FFC9D8" />
                        <Ellipse Width="46" Height="46" Fill="#FF7FA0" Margin="0,0,0,10" />
                        <Ellipse Width="18" Height="18" Fill="#FFE066" Margin="0,0,0,10" />
                        <Rectangle Width="5" Height="40" Fill="#5DB847" VerticalAlignment="Bottom" />
                    </Grid>
                </Border>
                <TextBlock Canvas.Left="26" Canvas.Top="172" Text="Photos" Style="{StaticResource ArtLabel}" Foreground="#D98A1E" />
                <TextBlock Canvas.Left="24" Canvas.Top="169" Text="Photos" Style="{StaticResource ArtLabel}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <!-- Internet -->
    <DataTemplate x:Key="Art.browser">
        <Viewbox Stretch="UniformToFill">
            <Canvas Width="400" Height="240" ClipToBounds="True">
                <Rectangle Width="400" Height="240">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#E3F6FF" Offset="0" />
                            <GradientStop Color="#78C8F2" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Ellipse Canvas.Left="206" Canvas.Top="28" Width="176" Height="176">
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.35,0.3">
                            <GradientStop Color="#7AD4FA" Offset="0" />
                            <GradientStop Color="#2690D1" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Canvas Canvas.Left="206" Canvas.Top="28" Width="176" Height="176">
                    <Canvas.Clip>
                        <EllipseGeometry Center="88,88" RadiusX="88" RadiusY="88" />
                    </Canvas.Clip>
                    <Canvas c:IdleAnim.Kind="Drift" c:IdleAnim.Distance="180">
                        <Path Fill="#8EE08A" Data="M20,40 C40,20 80,30 76,58 C72,84 44,90 38,70 C34,58 10,60 20,40 Z M104,96 C126,84 150,100 140,126 C132,146 106,140 100,120 C96,108 92,102 104,96 Z M60,120 C72,112 86,122 80,136 C74,148 58,142 60,120 Z" />
                        <Path Canvas.Left="180" Fill="#8EE08A" Data="M20,40 C40,20 80,30 76,58 C72,84 44,90 38,70 C34,58 10,60 20,40 Z M104,96 C126,84 150,100 140,126 C132,146 106,140 100,120 C96,108 92,102 104,96 Z M60,120 C72,112 86,122 80,136 C74,148 58,142 60,120 Z" />
                    </Canvas>
                    <Ellipse Canvas.Left="44" Width="88" Height="176" Stroke="#55FFFFFF" StrokeThickness="3" />
                    <Rectangle Canvas.Top="86" Width="176" Height="3" Fill="#55FFFFFF" />
                </Canvas>
                <Ellipse Canvas.Left="236" Canvas.Top="42" Width="70" Height="40" Fill="#66FFFFFF" />
                <Ellipse Canvas.Left="190" Canvas.Top="94" Width="208" Height="52" Stroke="White" StrokeThickness="5" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-18" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Canvas.Left="187" Canvas.Top="142" Width="18" Height="18" Fill="#FFE066" c:IdleAnim.Kind="Pulse" />
                <TextBlock Canvas.Left="24" Canvas.Top="23" Text="Internet" Style="{StaticResource ArtLabel}" FontSize="42" Foreground="#3A8FC0" />
                <TextBlock Canvas.Left="22" Canvas.Top="20" Text="Internet" Style="{StaticResource ArtLabel}" FontSize="42" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <!-- Customize -->
    <DataTemplate x:Key="Art.customize">
        <Viewbox Stretch="UniformToFill">
            <Canvas Width="400" Height="240" ClipToBounds="True">
                <Rectangle Width="400" Height="240">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#EDFADF" Offset="0" />
                            <GradientStop Color="#8DD26E" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Ellipse Canvas.Left="-40" Canvas.Top="-80" Width="200" Height="200" Fill="#33FFFFFF" />
                <Grid Canvas.Left="170" Canvas.Top="36" Width="200" Height="190">
                    <Path Data="M60,20 C130,-10 200,30 190,90 C185,125 150,110 140,130 C128,155 150,175 110,180 C40,188 0,140 10,90 C16,55 30,32 60,20 Z" Fill="#FBEBD0" Stroke="#D9B98A" StrokeThickness="4" />
                    <Ellipse Width="30" Height="26" Fill="#BEE7A5" Margin="62,58,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <Ellipse Width="34" Height="34" Fill="#F2556F" Margin="40,110,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <Ellipse Width="34" Height="34" Fill="#FFD23F" Margin="96,36,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <Ellipse Width="34" Height="34" Fill="#35B4E5" Margin="142,62,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <Ellipse Width="34" Height="34" Fill="#9B6BDB" Margin="92,128,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                </Grid>
                <Grid Canvas.Left="120" Canvas.Top="40" Width="40" Height="170" RenderTransformOrigin="0.5,0.9" c:IdleAnim.Kind="Sway">
                    <Rectangle Width="16" Height="110" RadiusX="8" RadiusY="8" Fill="#B97A45" VerticalAlignment="Bottom" />
                    <Rectangle Width="20" Height="22" Fill="#C9CFD3" VerticalAlignment="Top" Margin="0,40,0,0" />
                    <Path Data="M4,44 C4,20 12,0 20,0 C28,0 36,20 36,44 Z" Fill="#35B4E5" />
                </Grid>
                <TextBlock Canvas.Left="24" Canvas.Top="175" Text="Customize" Style="{StaticResource ArtLabel}" FontSize="40" Foreground="#5DA43F" />
                <TextBlock Canvas.Left="22" Canvas.Top="172" Text="Customize" Style="{StaticResource ArtLabel}" FontSize="40" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <!-- Settings -->
    <DataTemplate x:Key="Art.settings">
        <Viewbox Stretch="UniformToFill">
            <Canvas Width="400" Height="240" ClipToBounds="True">
                <Rectangle Width="400" Height="240">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#F7F9FA" Offset="0" />
                            <GradientStop Color="#C5CFD6" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Grid Canvas.Left="216" Canvas.Top="30" Width="160" Height="160" c:IdleAnim.Kind="Spin">
                    <Rectangle Width="32" Fill="#8C99A1" RadiusX="6" RadiusY="6" />
                    <Rectangle Width="32" Fill="#8C99A1" RadiusX="6" RadiusY="6" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="36" /></Rectangle.RenderTransform></Rectangle>
                    <Rectangle Width="32" Fill="#8C99A1" RadiusX="6" RadiusY="6" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="72" /></Rectangle.RenderTransform></Rectangle>
                    <Rectangle Width="32" Fill="#8C99A1" RadiusX="6" RadiusY="6" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="108" /></Rectangle.RenderTransform></Rectangle>
                    <Rectangle Width="32" Fill="#8C99A1" RadiusX="6" RadiusY="6" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="144" /></Rectangle.RenderTransform></Rectangle>
                    <Ellipse Width="124" Height="124" Fill="#8C99A1" />
                    <Ellipse Width="112" Height="112" Fill="#A3AEB5" />
                    <Ellipse Width="48" Height="48" Fill="#E7ECEF" />
                </Grid>
                <Grid Canvas.Left="150" Canvas.Top="128" Width="96" Height="96" c:IdleAnim.Kind="SpinReverse">
                    <Rectangle Width="20" Fill="#35B4E5" RadiusX="4" RadiusY="4" />
                    <Rectangle Width="20" Fill="#35B4E5" RadiusX="4" RadiusY="4" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="45" /></Rectangle.RenderTransform></Rectangle>
                    <Rectangle Width="20" Fill="#35B4E5" RadiusX="4" RadiusY="4" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="90" /></Rectangle.RenderTransform></Rectangle>
                    <Rectangle Width="20" Fill="#35B4E5" RadiusX="4" RadiusY="4" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><RotateTransform Angle="135" /></Rectangle.RenderTransform></Rectangle>
                    <Ellipse Width="72" Height="72" Fill="#35B4E5" />
                    <Ellipse Width="28" Height="28" Fill="#E7ECEF" />
                </Grid>
                <TextBlock Canvas.Left="24" Canvas.Top="23" Text="Settings" Style="{StaticResource ArtLabel}" Foreground="#7B8890" />
                <TextBlock Canvas.Left="22" Canvas.Top="20" Text="Settings" Style="{StaticResource ArtLabel}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <!-- Power -->
    <DataTemplate x:Key="Art.power">
        <Viewbox Stretch="UniformToFill">
            <Canvas Width="400" Height="240" ClipToBounds="True">
                <Rectangle Width="400" Height="240">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFEDF1" Offset="0" />
                            <GradientStop Color="#FF93AA" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Ellipse Canvas.Left="-60" Canvas.Top="130" Width="220" Height="220" Fill="#33FFFFFF" />
                <Grid Canvas.Left="226" Canvas.Top="40" Width="150" Height="150" c:IdleAnim.Kind="Pulse">
                    <Ellipse Fill="White" />
                    <Ellipse Margin="8" Stroke="#FFD2DC" StrokeThickness="4" />
                    <Path Data="M52,40 A40,40 0 1 0 98,40" Stroke="#E0556F" StrokeThickness="15" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path Data="M75,26 L75,72" Stroke="#E0556F" StrokeThickness="15" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Grid>
                <TextBlock Canvas.Left="24" Canvas.Top="175" Text="Power" Style="{StaticResource ArtLabel}" Foreground="#D9546F" />
                <TextBlock Canvas.Left="22" Canvas.Top="172" Text="Power" Style="{StaticResource ArtLabel}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>
</ResourceDictionary>
