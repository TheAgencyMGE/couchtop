<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        Dashboard shell. Not a Couchtop theme: this is the whole look of the Dashboard menu style, applied to
        every screen so Settings, Files, Power and the dialogs match the home screen. Graphite and near-black,
        one bright green, square corners, flat surfaces, no gloss and no scenery. Deliberately has no Art.*
        templates: the shell draws apps with their own icons instead of illustrated channel art.
    -->

    <FontFamily x:Key="AppFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <CornerRadius x:Key="PillCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="PillGlowCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="PillGlossCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="RoundCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="TileCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="TileGlowCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="TileGlossCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="PanelCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="ItemCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="InputCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="TrackCornerRadius">2</CornerRadius>
    <Thickness x:Key="PillBorderThickness">2</Thickness>
    <Thickness x:Key="RoundBorderThickness">2</Thickness>
    <Thickness x:Key="TileBorderThickness">2</Thickness>
    <Thickness x:Key="PanelBorderThickness">2</Thickness>
    <sys:Double x:Key="TileClipRadius">0</sys:Double>
    <sys:Double x:Key="TileChamfer">0</sys:Double>
    <sys:Double x:Key="TileGlossOpacity">0</sys:Double>
    <Color x:Key="CardMixColor">#14181A</Color>
    <sys:Double x:Key="CardMixTop">0.82</sys:Double>
    <sys:Double x:Key="CardMixBottom">0.82</sys:Double>
    <Color x:Key="BarShadowColor">#000000</Color>
    <sys:Double x:Key="BarShadowOpacity">0.6</sys:Double>

    <Color x:Key="AccentColor">#7BC618</Color>
    <Color x:Key="AccentDeepColor">#9BE04A</Color>
    <Color x:Key="TileBorderColor">#2A3033</Color>
    <Color x:Key="ButtonBorderColor">#394246</Color>
    <Color x:Key="ButtonTextColor">#E8EDEA</Color>

    <LinearGradientBrush x:Key="BackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#101614" Offset="0" />
        <GradientStop Color="#050708" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="StripeBrush" Color="#00000000" />

    <SolidColorBrush x:Key="AccentBrush" Color="#7BC618" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="#9BE04A" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#557BC618" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1B2415" />
    <SolidColorBrush x:Key="TileGlowBrush" Color="#4D7BC618" />
    <SolidColorBrush x:Key="BadgeRimBrush" Color="#0A0D0B" />

    <SolidColorBrush x:Key="TextBrush" Color="#F0F4F1" />
    <SolidColorBrush x:Key="TileTextBrush" Color="#F0F4F1" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#93A39A" />
    <SolidColorBrush x:Key="ClockBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InverseTextBrush" Color="#0A0D0B" />

    <SolidColorBrush x:Key="TileBorderBrush" Color="#2A3033" />
    <SolidColorBrush x:Key="BubbleBorderBrush" Color="#394246" />
    <SolidColorBrush x:Key="TileBackgroundBrush" Color="#1C2022" />
    <SolidColorBrush x:Key="EmptyTileBrush" Color="#8014181A" />
    <SolidColorBrush x:Key="EmptyTileBorderBrush" Color="#232A2D" />
    <SolidColorBrush x:Key="GlossBrush" Color="#00FFFFFF" />

    <SolidColorBrush x:Key="BarBrush" Color="#0C100E" />
    <SolidColorBrush x:Key="BarLineBrush" Color="#7BC618" />

    <SolidColorBrush x:Key="PanelBrush" Color="#F2141819" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#2D3538" />
    <SolidColorBrush x:Key="CardBrush" Color="#191E20" />

    <SolidColorBrush x:Key="ButtonBrush" Color="#1E2426" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#394246" />
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#E8EDEA" />
    <SolidColorBrush x:Key="TrackBrush" Color="#2A3236" />
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#C4000000" />

    <SolidColorBrush x:Key="HeaderBrush" Color="#F20E1210" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#7BC618" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F2685E" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E8A33C" />

    <!-- The shell uses the normal Windows pointer, so these only matter if the hand is ever forced on. -->
    <SolidColorBrush x:Key="PointerFillBrush" Color="#F0F4F1" />
    <SolidColorBrush x:Key="PointerOutlineBrush" Color="#0A0D0B" />
    <SolidColorBrush x:Key="PointerShadowBrush" Color="#000000" />
    <SolidColorBrush x:Key="PointerCuffBrush" Color="#7BC618" />
    <RadialGradientBrush x:Key="SplashGlowBrush">
        <GradientStop Color="#387BC618" Offset="0" />
        <GradientStop Color="#007BC618" Offset="1" />
    </RadialGradientBrush>

    <SolidColorBrush x:Key="QuickScrimBrush" Color="#D2040605" />
    <SolidColorBrush x:Key="QuickTopBrush" Color="#F50E1210" />
    <SolidColorBrush x:Key="QuickTopLineBrush" Color="#7BC618" />
    <SolidColorBrush x:Key="QuickBottomBrush" Color="#F50A0D0B" />
    <SolidColorBrush x:Key="QuickTextBrush" Color="#F0F4F1" />

    <!-- No drifting scenery: this shell's background is flat, with the home screen supplying its own glow. -->
    <DataTemplate x:Key="BackgroundDecorTemplate"><Grid /></DataTemplate>
    <DataTemplate x:Key="TileDecorTemplate"><Grid /></DataTemplate>
</ResourceDictionary>
