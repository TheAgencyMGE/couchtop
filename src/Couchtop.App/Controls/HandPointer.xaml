<UserControl x:Class="Couchtop.App.Controls.HandPointer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="64" Height="80" IsHitTestVisible="False" Focusable="False">
    <!-- Original hand pointer: white glove, blue outline, player-one badge. Hotspot is the fingertip. -->
    <Canvas>
        <Canvas.CacheMode>
            <BitmapCache RenderAtScale="2.5" SnapsToDevicePixels="False" />
        </Canvas.CacheMode>
        <Canvas Canvas.Left="7" Canvas.Top="8" Opacity="0.28">
            <Canvas.RenderTransform>
                <ScaleTransform ScaleX="1.2" ScaleY="1.2" />
            </Canvas.RenderTransform>
            <Path Fill="#0B3A66" Data="M 14,22 L 14,6 C 14,1 22,1 22,6 L 22,20 C 23,17 29,17 29,21 C 30,18 35,18 35,23 C 36,20 41,21 40,26 L 40,36 C 40,46 34,52 26,52 L 20,52 C 13,52 9,48 7,43 L 3,33 C 1,29 6,26 9,29 L 14,35 Z" />
        </Canvas>
        <Canvas Canvas.Left="4" Canvas.Top="4">
            <Canvas.RenderTransform>
                <ScaleTransform ScaleX="1.2" ScaleY="1.2" />
            </Canvas.RenderTransform>
            <Rectangle Canvas.Left="14" Canvas.Top="49" Width="22" Height="9" RadiusX="3" RadiusY="3" Fill="#E8F3FB" Stroke="#1B6FB8" StrokeThickness="2.4" />
            <Path Stroke="#1B6FB8" StrokeThickness="2.6" StrokeLineJoin="Round"
                  Data="M 14,22 L 14,6 C 14,1 22,1 22,6 L 22,20 C 23,17 29,17 29,21 C 30,18 35,18 35,23 C 36,20 41,21 40,26 L 40,36 C 40,46 34,52 26,52 L 20,52 C 13,52 9,48 7,43 L 3,33 C 1,29 6,26 9,29 L 14,35 Z">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                        <GradientStop Color="#FFFFFF" Offset="0" />
                        <GradientStop Color="#FFFFFF" Offset="0.45" />
                        <GradientStop Color="#C9E4F8" Offset="1" />
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
            <Path Stroke="#1B6FB8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 22,20 L 22,27 M 29,21 L 29,28 M 35,23 L 35,29" />
            <TextBlock Canvas.Left="23.5" Canvas.Top="33" Text="1" FontSize="11" FontWeight="ExtraBold" Foreground="#1B6FB8" FontFamily="{StaticResource AppFont}" />
        </Canvas>
    </Canvas>
</UserControl>
